# --- Backend / API ---

# MongoDB Atlas connection string.
MONGODB_URI=

# Any long random string — used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session stays valid.
JWT_EXPIRES_IN=7d

# Port the Express dev server runs on locally (npm run dev:backend).
PORT=5000

# Where the frontend dev server runs, for CORS during local development.
# Not needed in production — frontend and API share one domain there.
CLIENT_ORIGIN=http://localhost:5173

# --- Frontend ---

# Locally, the frontend (port 5173) and backend (port 5000) run as two
# separate dev servers, so this needs the full URL. In production, leave
# VITE_API_URL unset in Vercel — the app defaults to a relative "/api",
# which is correct once both are deployed together on one domain.
VITE_API_URL=http://localhost:5000/api
