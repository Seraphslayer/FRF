# MongoDB Atlas connection string. Paste the one Atlas gives you after you
# create the cluster + database user tonight, and swap <password>/<dbname>.
# Example:
# MONGODB_URI=mongodb+srv://frpUser:<password>@cluster0.xxxxx.mongodb.net/frp?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string — used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session stays valid.
JWT_EXPIRES_IN=7d

# Port the API runs on locally.
PORT=5000

# Where the Vite frontend runs, for CORS.
CLIENT_ORIGIN=http://localhost:5173
